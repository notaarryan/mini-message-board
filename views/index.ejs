<html>

<head>
    <title>
        <%= title %>
    </title>
</head>

<body>
    <div>
        <% if (username) { %>
            <div>
                <p>Username: <%= username %>
                </p>
            </div>
            <% } %>
    </div>
    <% if (!username) { %>
        <div>
            <%- include('setUserNameForm') %>
        </div>
        <% } else { %>
            <div>
                <%- include('updateUserNameForm.ejs') %>
            </div>
            <% } %>
                <div class="message-card">
                    <% for( let i=0; i < messages.length; i++ ) { %>
                        <div>
                            <p>
                                <%= messages[i].user %>
                            </p>
                            <p>
                                <%= messages[i].text %>
                            </p>
                            <p>
                                <%= messages[i].added %>
                            </p>
                        </div>
                        <% } %>
                </div>
                <div class="new-message-card">
                    <a href="/new"><Button>New Message</Button></a>
                </div>
</body>

</html>