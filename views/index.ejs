<html>

<head>
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="styles/index.css">
</head>

<body>
    <div class="container">
        <div class="username-display">
            <% if (username) { %>
                <div>
                    <p>Username: <%= username %>
                    </p>
                </div>
                <% } %>
        </div>
        <% if (!username) { %>
            <div class="form-container">
                <%- include('setUserNameForm') %>
            </div>
            <% } else { %>
                <div class="form-container">
                    <%- include('updateUserNameForm.ejs') %>
                </div>
                <% } %>
                    <div class="message-container">
                        <% messages.forEach(message=> { %>
                            <div class="messages">
                                <p>
                                    <%= message.username %>
                                </p>
                                <p>
                                    <%= message.message %>
                                </p>
                                <p>
                                    <%= new Date(message.added).toLocaleString("en-CA", { dateStyle: "medium" ,
                                        timeStyle: "short" }) %>
                                </p>
                            </div>
                            <% }) %>
                    </div>
                    <div class="new-message-button-container">
                        <a href="/new"><Button>New Message</Button></a>
                    </div>
    </div>
</body>

</html>